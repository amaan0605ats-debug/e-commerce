PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=algani_db
# Render / TiDB / other cloud — use instead of DB_HOST when deploying
# MYSQL_URL=mysql://user:password@host:4000/algani_db
# DB_SSL=true

# Railway MySQL plugin (auto-injected when you add MySQL to the project)
# MYSQLHOST=...
# MYSQLPORT=3306
# MYSQLUSER=...
# MYSQLPASSWORD=...
# MYSQLDATABASE=railway
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD_1=replace-with-a-strong-unique-password
# Optional sample records for a disposable development database only
# SEED_DEMO_DATA=true

# Customer email delivery uses Resend HTTPS and the database outbox.
# Use a verified sender domain; SMTP settings are not used.
RESEND_API_KEY=
RESEND_FROM=
# Optional owner alert recipient; enable only after confirming the destination.
OWNER_NOTIFICATION_EMAIL=
# Optional PEM CA certificate for managed MySQL. Verification is always enabled.
DB_SSL_CA=

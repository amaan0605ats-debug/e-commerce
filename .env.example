PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=algani_db
# Render / TiDB / other cloud — use instead of DB_HOST when deploying
# MYSQL_URL=mysql://user:password@host:4000/algani_db
# DB_SSL=true

# Railway MySQL plugin (auto-injected when you add MySQL to the project)
# MYSQLHOST=...
# MYSQLPORT=3306
# MYSQLUSER=...
# MYSQLPASSWORD=...
# MYSQLDATABASE=railway
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD_1=replace-with-a-strong-unique-password
# Optional sample records for a disposable development database only
# SEED_DEMO_DATA=true

# SMTP — required for live customer emails (optional in dev; logs dry-run if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alganigeneralsupplier@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Al Gani General Suppliers <alganigeneralsupplier@gmail.com>"
